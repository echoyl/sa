SET NAMES utf8mb4;
SET FOREIGN_KEY_CHECKS = 0;

-- ----------------------------
-- Table structure for la_dev_menu
-- ----------------------------
DROP TABLE IF EXISTS `la_dev_menu`;
CREATE TABLE `la_dev_menu`  (
  `id` int NOT NULL AUTO_INCREMENT,
  `title` varchar(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT '',
  `path` varchar(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT '',
  `parent_id` int NOT NULL DEFAULT 0,
  `displayorder` int NOT NULL DEFAULT 0,
  `status` int NOT NULL DEFAULT 0 COMMENT '菜单隐藏控制 1显示0隐藏',
  `icon` varchar(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT '' COMMENT '菜单图标',
  `desc` text CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NULL COMMENT '额外数据 json',
  `created_at` datetime NULL DEFAULT NULL,
  `updated_at` datetime NULL DEFAULT NULL,
  `state` int NULL DEFAULT 0 COMMENT '状态 enum 1和 0',
  `model` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NULL DEFAULT '' COMMENT '模型名称',
  `category_id` int NULL DEFAULT 0 COMMENT '模型的分类id值',
  `_category_id` varchar(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NULL DEFAULT '',
  `router` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NULL DEFAULT '' COMMENT '菜单指定路由 空的话自动根据父级拼接',
  `perms` varchar(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NULL DEFAULT '' COMMENT '菜单指定的子权限json',
  `type` varchar(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NULL DEFAULT 'system' COMMENT '菜单类型 system -系统菜单 其它-对应项目菜单',
  `admin_model_id` int NOT NULL DEFAULT 0 COMMENT '所选的模型id',
  `table_config` text CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NULL COMMENT '列表展示列的配置信息',
  `form_config` text CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NULL COMMENT '表单展示的配置信息',
  `other_config` text CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NULL COMMENT '其它额外配置信息',
  `page_type` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT '' COMMENT '菜单页面类型 category or table',
  `open_type` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT 'page' COMMENT 'form页面打开方式 page or drawer',
  `addable` int NOT NULL DEFAULT 1 COMMENT '是否可以新增',
  `editable` int NOT NULL DEFAULT 1 COMMENT '表单是否可以 提交',
  `deleteable` int NOT NULL DEFAULT 1 COMMENT '数据是否可以删除',
  `setting` text CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NULL COMMENT '其它设置都放这',
  `title_locale` longtext CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NULL COMMENT '菜单名称多语言内容',
  PRIMARY KEY (`id`) USING BTREE
) ENGINE = InnoDB AUTO_INCREMENT = 10003 CHARACTER SET = utf8mb4 COLLATE = utf8mb4_general_ci ROW_FORMAT = DYNAMIC;

-- ----------------------------
-- Records of la_dev_menu
-- ----------------------------
INSERT INTO `la_dev_menu` VALUES (8, '工作台', 'dashboard', 0, 100, 1, 'dashboard', '{\"postUrl\":\"\",\"url\":\"\"}', '2022-08-23 17:05:11', '2026-03-02 17:10:50', 1, '', 0, '', '', '', 'system', 0, NULL, NULL, '', '', '', 1, 1, 1, NULL, '{\"title_en-US\":\"Dashboard\"}');
