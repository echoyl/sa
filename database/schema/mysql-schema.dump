-- ----------------------------
-- Table structure for la_setting
-- ----------------------------
DROP TABLE IF EXISTS `la_setting`;
CREATE TABLE `la_setting`  (
  `id` int NOT NULL AUTO_INCREMENT COMMENT 'id',
  `key` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT '' COMMENT '键值',
  `value` text CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NULL COMMENT '值',
  `app_name` varchar(50) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT '' COMMENT '项目名称',
  PRIMARY KEY (`id`) USING BTREE,
  UNIQUE INDEX `key`(`key`, `app_name`) USING BTREE
) ENGINE = MyISAM AUTO_INCREMENT = 2 CHARACTER SET = utf8mb4 COLLATE = utf8mb4_general_ci ROW_FORMAT = DYNAMIC;

