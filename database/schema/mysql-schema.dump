-- ----------------------------
-- Table structure for la_dev_model_relation
-- ----------------------------
DROP TABLE IF EXISTS `la_dev_model_relation`;
CREATE TABLE `la_dev_model_relation`  (
  `id` int NOT NULL AUTO_INCREMENT,
  `model_id` int NOT NULL DEFAULT 0 COMMENT '所属模型id',
  `title` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT '' COMMENT '关系名称',
  `name` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT '' COMMENT '模型关系名称',
  `type` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT '' COMMENT '关系类型 one | many',
  `foreign_model_id` int NOT NULL DEFAULT 0 COMMENT '关联模型id',
  `foreign_key` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT '' COMMENT '关联模型字段名称',
  `local_key` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT '' COMMENT '当前模型的字段名称',
  `created_at` datetime NULL DEFAULT NULL,
  `updated_at` datetime NULL DEFAULT NULL,
  `can_search` int NOT NULL DEFAULT 0 COMMENT '1-支持搜索',
  `search_columns` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT '' COMMENT '搜索哪些字段',
  `show_column_name` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NULL DEFAULT '' COMMENT '关联模型展示信息的字段名称',
  `with_count` int NOT NULL DEFAULT 0 COMMENT '是否计算数量',
  `with_sum` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT '' COMMENT '如果类型是hasmany的话 存储需要计算和的字段',
  `is_with` int NOT NULL DEFAULT 1 COMMENT '该关联是否加入with数组',
  `select_columns` varchar(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT '' COMMENT '关联模型包含字段 可以包含多级',
  `is_with_in_page` int NULL DEFAULT NULL COMMENT '该关联是否加入页面级的with,数据会设置到columnData中 组件可以使用这个context',
  `in_page_select_columns` varchar(255) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT '' COMMENT '关联包含的字段 这个只包含一级',
  `with_default` varchar(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT '' COMMENT '关联的默认返回数据withDefault',
  `filter` varchar(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT '' COMMENT '关联模型数据筛选条件',
  `order_by` varchar(500) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL DEFAULT '' COMMENT '关联数据排序方式',
  `setting` text COLLATE utf8mb4_general_ci COMMENT '其它设置放在这里，之后不再新增字段',
  PRIMARY KEY (`id`) USING BTREE
) ENGINE = InnoDB AUTO_INCREMENT = 10000 CHARACTER SET = utf8mb4 COLLATE = utf8mb4_general_ci ROW_FORMAT = DYNAMIC;

-- ----------------------------
-- Records of la_dev_model_relation
-- ----------------------------
